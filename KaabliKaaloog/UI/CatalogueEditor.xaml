<Window
    x:Class="KaabliKataloog.CatalogueEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Lisa kaabel"
    Width="560"
    Height="720"
    MinWidth="480"
    MinHeight="480"
    Background="{DynamicResource Window.Background}"
    ShowInTaskbar="False"
    TextOptions.TextFormattingMode="Display"
    UseLayoutRounding="True"
    WindowStartupLocation="CenterOwner">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="52"
            CornerRadius="0"
            GlassFrameThickness="0,0,0,1"
            NonClientFrameEdges="None"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KaabliKataloog;component/UI/Themes/DarkTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/KaabliKataloog;component/UI/Themes/ElementStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style BasedOn="{StaticResource Type.Label}" TargetType="{x:Type TextBlock}" x:Key="FieldLabel">
                <Setter Property="Grid.Column" Value="0" />
            </Style>
            <Style BasedOn="{StaticResource Input.Text}" TargetType="{x:Type TextBox}" x:Key="Field">
                <Setter Property="Grid.Column" Value="1" />
            </Style>
            <Style BasedOn="{StaticResource Input.Text}" TargetType="{x:Type TextBox}" x:Key="NumberField">
                <Setter Property="Grid.Column" Value="1" />
                <Setter Property="Width" Value="120" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="TextAlignment" Value="Right" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid
        TextElement.FontFamily="{StaticResource Font.Text}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{DynamicResource Text.Primary}">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Title area (draggable)  -->
        <DockPanel Background="Transparent">
            <Button
                VerticalAlignment="Top"
                AutomationProperties.Name="Sulge"
                Click="Close_Click"
                DockPanel.Dock="Right"
                Style="{StaticResource Caption.Close}"
                ToolTip="Sulge (Esc)">
                <materialDesign:PackIcon
                    Width="14"
                    Height="14"
                    Kind="WindowClose" />
            </Button>
            <TextBlock
                Margin="24,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource Type.Title}"
                Text="Lisa kaabel" />
        </DockPanel>

        <ScrollViewer
            Grid.Row="1"
            Focusable="False"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,0,24,16">
                <!--  Live preview: the name the type will get in Revit  -->
                <Border Margin="0,0,0,16" Style="{StaticResource InsetCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Type.Caption}" Text="Nimi Revitis" />
                        <TextBlock
                            x:Name="PreviewName"
                            Margin="0,2,0,0"
                            FontFamily="{StaticResource Font.Display}"
                            FontSize="{StaticResource FontSize.Title}"
                            FontWeight="SemiBold"
                            Text="—"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!--  Cable  -->
                <TextBlock
                    Margin="4,0,0,6"
                    Style="{StaticResource Type.Group}"
                    Text="KAABEL" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Kaabli tüüp *" />
                        <TextBox
                            x:Name="TxtWireName"
                            AutomationProperties.Name="Kaabli tüüp"
                            Style="{StaticResource Field}"
                            Tag="Nt JMK, ÖKKJ"
                            TextChanged="Field_Changed" />

                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource FieldLabel}"
                            Text="Materjal *" />
                        <ComboBox
                            x:Name="CmbMaterial"
                            Grid.Row="2"
                            Grid.Column="1"
                            AutomationProperties.Name="Materjal"
                            SelectionChanged="Field_Changed"
                            Style="{StaticResource Input.Combo}"
                            Tag="Vali materjal" />

                        <TextBlock
                            Grid.Row="4"
                            Style="{StaticResource FieldLabel}"
                            Text="Tulereaktsiooni klass" />
                        <TextBox
                            x:Name="TxtFireClass"
                            Grid.Row="4"
                            AutomationProperties.Name="Tulereaktsiooni klass"
                            Style="{StaticResource Field}"
                            Tag="Nt Cca, B2ca" />

                        <CheckBox
                            x:Name="ChkHalogenFree"
                            Grid.Row="6"
                            Grid.Column="1"
                            Content="Halogeenivaba"
                            Style="{StaticResource Input.Check}" />
                    </Grid>
                </Border>

                <!--  Conductors  -->
                <TextBlock
                    Margin="4,20,0,6"
                    Style="{StaticResource Type.Group}"
                    Text="JUHID" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Soonte arv *" />
                        <TextBox
                            x:Name="TxtConductorCount"
                            AutomationProperties.Name="Soonte arv"
                            Style="{StaticResource NumberField}"
                            Tag="Nt 3"
                            TextChanged="Field_Changed" />

                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource FieldLabel}"
                            Text="Juhi ristlõige (mm²) *" />
                        <TextBox
                            x:Name="TxtWireSize"
                            Grid.Row="2"
                            AutomationProperties.Name="Juhi ristlõige"
                            Style="{StaticResource NumberField}"
                            Tag="Nt 1.5"
                            TextChanged="Field_Changed" />

                        <CheckBox
                            x:Name="ChkKoosKaitsejuhiga"
                            Grid.Row="4"
                            Grid.Column="1"
                            Checked="Field_Changed"
                            Content="Koos kaitsejuhiga"
                            IsChecked="True"
                            Style="{StaticResource Input.Check}"
                            Unchecked="Field_Changed" />
                        <CheckBox
                            x:Name="ChkUvKindel"
                            Grid.Row="6"
                            Grid.Column="1"
                            Content="UV-kindel"
                            Style="{StaticResource Input.Check}" />
                    </Grid>
                </Border>

                <!--  Dimensions  -->
                <TextBlock
                    Margin="4,20,0,6"
                    Style="{StaticResource Type.Group}"
                    Text="MÕÕDUD" />
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Välisläbimõõt (mm)" />
                        <TextBox
                            x:Name="TxtVälisläbimõõt"
                            AutomationProperties.Name="Välisläbimõõt"
                            Style="{StaticResource NumberField}" />

                        <TextBlock
                            Grid.Row="2"
                            Style="{StaticResource FieldLabel}"
                            Text="Painderaadius (mm)" />
                        <TextBox
                            x:Name="TxtPainderaadius"
                            Grid.Row="2"
                            AutomationProperties.Name="Painderaadius"
                            Style="{StaticResource NumberField}" />

                        <TextBlock
                            Grid.Row="4"
                            Style="{StaticResource FieldLabel}"
                            Text="Koormusvool (A)" />
                        <TextBox
                            x:Name="TxtCurrentCapacity"
                            Grid.Row="4"
                            AutomationProperties.Name="Koormusvool"
                            Style="{StaticResource NumberField}"
                            Tag="Nt 13.5"
                            TextChanged="Field_Changed" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  Footer: inline feedback (left), actions (right; Enter adds, Esc closes)  -->
        <Border
            Grid.Row="2"
            Padding="24,12,24,16"
            BorderBrush="{DynamicResource Separator}"
            BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Click="Close_Click"
                        Content="Valmis"
                        IsCancel="True"
                        Style="{StaticResource Button.Secondary}" />
                    <Button
                        x:Name="BtnAddEntry"
                        MinWidth="120"
                        Click="BtnAddEntry_Click"
                        Content="Lisa kataloogi"
                        IsDefault="True"
                        Style="{StaticResource Button.Primary}" />
                </StackPanel>

                <StackPanel
                    x:Name="FeedbackLine"
                    VerticalAlignment="Center"
                    AutomationProperties.LiveSetting="Polite"
                    Orientation="Horizontal">
                    <materialDesign:PackIcon
                        x:Name="FeedbackIcon"
                        Width="15"
                        Height="15"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Visibility="Collapsed" />
                    <TextBlock
                        x:Name="TxtFeedback"
                        MaxWidth="260"
                        VerticalAlignment="Center"
                        Style="{StaticResource Type.Secondary}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
